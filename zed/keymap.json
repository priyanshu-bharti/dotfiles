[
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
        }
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "alt-shift-f": "editor::Format"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-cmd-shift-e": "workspace::ToggleLeftDock"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-b": "workspace::ToggleRightDock"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "cmd-shift-j": "workspace::ToggleZoom"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-r": [
                "projects::OpenRecent",
                {
                    "create_new_window": false
                }
            ]
        }
    }
]
